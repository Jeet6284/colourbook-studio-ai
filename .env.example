# ---- Required in production ----
NODE_ENV=production
# Long random string, e.g. `openssl rand -hex 32`. Signs login cookies.
SESSION_SECRET=
# Public https URL of your site (used for payment redirects).
PUBLIC_URL=https://your-app.example.com

# ---- AI image generation (server-side only - never put keys in frontend code) ----
# "openai" = real AI illustrations. Leave OPENAI_API_KEY empty to run in DEMO mode (simple built-in drawings).
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible Images API

# ---- Storage ----
# Folder (mount a persistent disk/volume here). Holds users.json and every book's pictures.
DATA_DIR=/data

# ---- Limits ----
GEN_CONCURRENCY=3
FREE_DAILY_GENERATIONS=30
PREMIUM_DAILY_GENERATIONS=300
# SIGNUPS_OPEN=false          # close registration once your testers are in
# TRUST_PROXY=1               # number of reverse proxies in front of the app

# ---- Payments (leave empty until Stripe is configured; the Upgrade button then explains payments are off) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- Local development only ----
# ALLOW_DEV_PLAN_SWITCH=true  # shows a Free/Premium toggle in Settings (ignored when NODE_ENV=production)
